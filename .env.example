# Reuse the Gemini API key already configured for Companion OS / CLIVE.
# Put the real value in Vercel Environment Variables, never in GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# Optional: set a long random secret and keep it stable to preserve encrypted saves.
ADVENTURE_STATE_SECRET=
